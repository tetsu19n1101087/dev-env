---
// サンプルコンポーネント。命名規則・画像最適化・コンポーネント CSS（is:global + @layer components）・mixin の書き方を示す。
// Block 名（.p-Hero）はファイル名と一致させる。案件開始時に差し替えるか削除する。
import { Picture } from 'astro:assets';
import heroBg from '@/assets/images/hero/hero-bg.jpg';

const base = import.meta.env.BASE_URL;
---

<section class="p-Hero" aria-labelledby="hero-ttl">
  {/* LCP 候補なので priority（eager + fetchpriority="high"）。ページ内で1枚だけにする */}
  <Picture
    class="p-Hero__bg"
    src={heroBg}
    formats={['avif', 'webp']}
    layout="full-width"
    sizes="100vw"
    alt=""
    priority
  />
  <div class="p-Hero__inner">
    <h1 class="p-Hero__ttl" id="hero-ttl">
      見出しテキスト
    </h1>
    <p class="p-Hero__lead">リード文が入ります。</p>
    <a class="p-Hero__btn" href="#">
      詳しく見る
      {/* public/ の素材は BASE_URL を付けて参照する。最適化を通らないので寸法は手で書く */}
      <img class="p-Hero__btnIcon" src={`${base}images/hero/hero-icon-arrow.svg`} width="16" height="16" alt="" />
    </a>
  </div>
</section>

<style is:global lang="scss">
  @layer components {
    .p-Hero {
      position: relative;
      display: grid;
      min-block-size: rem(480);
      isolation: isolate;

      @include min-screen(md) {
        min-block-size: rem(640);
      }
    }

    .p-Hero__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .p-Hero__inner {
      display: grid;
      gap: rem(16);
      place-content: center;
      padding: rem(24);
      color: #fff;
      text-align: center;
    }

    .p-Hero__ttl {
      margin: 0;
      font-size: clamp(#{rem(28)}, 1rem + 3vw, #{rem(48)});
      line-height: 1.3;
      text-wrap: balance;
    }

    .p-Hero__btn {
      display: inline-flex;
      gap: rem(8);
      align-items: center;
      justify-self: center;
      min-block-size: rem(48);
      padding-inline: rem(24);
      color: var(--color-accent);
      background-color: #fff;
      border-radius: 999px;
      transition: opacity 0.2s;

      @include hover {
        opacity: 0.8;
      }
    }
  }
</style>
